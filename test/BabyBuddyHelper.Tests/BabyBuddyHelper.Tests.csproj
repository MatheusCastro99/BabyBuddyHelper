<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- xUnit v3 test projects are executables -->
		<OutputType>Exe</OutputType>
		<RootNamespace>BabyBuddyHelper.Tests</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- The app project targets platform frameworks only, so a plain net10.0 project can't reference it (#104).
	     The Core/ source files are compiled into this project instead: a file added to Core/ is picked up with no edit here.
	     SecureApiKeyStore and PreferencesCubPersonalityStore are left out because they need MAUI's SecureStorage and Preferences.
	     Remote/ is linked the same way; its tests replace the network with a fake (ADR-018). -->
	<ItemGroup>
		<Compile Include="../../Core/**/*.cs" Exclude="../../Core/Storage/SecureApiKeyStore.cs;../../Core/Storage/PreferencesCubPersonalityStore.cs" LinkBase="Core" />
		<Compile Include="../../Remote/**/*.cs" LinkBase="Remote" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<!-- Keep in step with the app project: the linked Core/ and Remote/ code is compiled against these versions here -->
		<PackageReference Include="Anthropic" Version="13.3.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>

</Project>
