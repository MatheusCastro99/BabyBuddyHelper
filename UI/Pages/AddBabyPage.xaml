<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyBuddyHelper.UI.Pages.AddBabyPage"
             Title="Baby Profile"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HeaderTitleLabel" Text="Add baby profile" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="Keep the details you need in one calm, caring place." Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Profile details" Style="{StaticResource SectionTitle}" />

                    <Entry x:Name="NameEntry" Placeholder="Name" TextColor="{DynamicResource BabyBuddyText}">
                        <Entry.Keyboard>
                            <Keyboard x:FactoryMethod="Create">
                                <x:Arguments>
                                    <KeyboardFlags>CapitalizeWord,CapitalizeSentence,Spellcheck,Suggestions</KeyboardFlags>
                                </x:Arguments>
                            </Keyboard>
                        </Entry.Keyboard>
                    </Entry>

                    <!--Two-cell rows stack when a cell is too wide for its half (large text): OnPairSizeChanged-->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" SizeChanged="OnPairSizeChanged">
                        <Entry x:Name="WeightEntry" Grid.Column="0" Placeholder="Weight in lbs" Keyboard="Numeric" TextColor="{DynamicResource BabyBuddyText}"/>
                        <Entry x:Name="HeightEntry" Grid.Column="1" Placeholder="Height in ft" Keyboard="Numeric" TextColor="{DynamicResource BabyBuddyText}"/>
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Date of birth" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="None" />
                        <Border BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" Stroke="{DynamicResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                            <DatePicker x:Name="DateOfBirthPicker" SemanticProperties.Hint="Date of birth" MinimumHeightRequest="48" TextColor="{DynamicResource BabyBuddyText}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Last feed" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="None" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" SizeChanged="OnPairSizeChanged">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" Stroke="{DynamicResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <DatePicker x:Name="LastFeedDatePicker" SemanticProperties.Hint="Last feed date" MinimumHeightRequest="48" TextColor="{DynamicResource BabyBuddyText}"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" Stroke="{DynamicResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <TimePicker x:Name="LastFeedTimePicker" SemanticProperties.Hint="Last feed time" MinimumHeightRequest="48" HorizontalOptions="Center" TextColor="{DynamicResource BabyBuddyText}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Last sleep" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="None" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" SizeChanged="OnPairSizeChanged">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" Stroke="{DynamicResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <DatePicker x:Name="LastSleepDatePicker" SemanticProperties.Hint="Last sleep date" MinimumHeightRequest="48" TextColor="{DynamicResource BabyBuddyText}"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" Stroke="{DynamicResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <TimePicker x:Name="LastSleepTimePicker" SemanticProperties.Hint="Last sleep time" MinimumHeightRequest="48" HorizontalOptions="Center" TextColor="{DynamicResource BabyBuddyText}"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryAction}" Clicked="OnCancelClicked" />
                <Button x:Name="SaveButton" Grid.Column="1" Text="Save" Style="{StaticResource PrimaryAction}" Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
