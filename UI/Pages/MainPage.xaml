<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             xmlns:converters="clr-namespace:BabyBuddyHelper.UI.Converters"
             x:Class="BabyBuddyHelper.UI.Pages.MainPage"
             x:Name="HomeRoot"
             Title="Home"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:VaccineTagConverter x:Key="VaccineTagConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">
                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="20" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Good morning" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                        <Label Text="{Binding CountdownText}" Style="{StaticResource PageTitle}" />
                        <Label Text="Your little routine is looking calm and steady today." Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{DynamicResource BabyBuddySecondary}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="🗓️" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="This Week" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding WeeklyAppointmentText}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{DynamicResource BabyBuddySuccess}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="✅" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Checklist" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding CompletedTaskText}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{DynamicResource BabyBuddyWarm}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="🧸" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Profiles" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ProfileCountText}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <controls:CompanionView x:Name="Companion" />

                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Baby profiles" Style="{StaticResource SectionTitle}" />
                                <Label Text="Keep each little routine close and easy to update." Style="{StaticResource BodyText}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Add profile"
                                    Style="{StaticResource PrimaryAction}"
                                    Padding="14,10"
                                    VerticalOptions="Center"
                                    Clicked="OnAddBabyProfileClicked" />
                        </Grid>

                        <Border IsVisible="{Binding HasNoBabyProfiles}"
                                BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}"
                                Stroke="{DynamicResource BabyBuddyBorder}"
                                Padding="16">
                            <Label Text="No baby profiles yet. Add one whenever you're ready, and we'll keep feeding and sleep details handy for you."
                                   Style="{StaticResource BodyText}" />
                        </Border>

                        <CollectionView ItemsSource="{Binding BabyProfiles}"
                                        IsVisible="{Binding HasBabyProfiles}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16"
                                            Margin="0,0,0,10"
                                            BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22"
                                            SemanticProperties.Hint="Opens this baby's profile">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnBabyProfileTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                                    <Label Text="{Binding AgeText}" Style="{StaticResource BodyText}" />

                                                    <!--Vaccines due today or within the next two weeks (#81). Hidden when nothing is due; overdue stays on the profile.
                                                        Tapping the card opens the profile, where each vaccine shows its own status-->
                                                    <Border Style="{StaticResource DueTag}" HorizontalOptions="Start" Margin="0,4,0,0">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{StaticResource VaccineTagConverter}">
                                                                <Binding Path="Id" />
                                                                <Binding Source="{x:Reference HomeRoot}" Path="VaccineTagsByBabyId" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <Label Style="{StaticResource DueTagText}">
                                                            <Label.Text>
                                                                <MultiBinding Converter="{StaticResource VaccineTagConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Source="{x:Reference HomeRoot}" Path="VaccineTagsByBabyId" />
                                                                </MultiBinding>
                                                            </Label.Text>
                                                        </Label>
                                                    </Border>
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        Padding="10,6"
                                                        BackgroundColor="{DynamicResource BabyBuddySecondary}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding WeightInLbs, StringFormat='{}{0:F1} lbs'}" Style="{StaticResource CaptionText}" />
                                                </Border>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                                    <Label Text="Height" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding HeightInFt, StringFormat='{}{0:F1} ft'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                                    <Label Text="Last feed" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding LastFeed, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                                    <Label Text="Last sleep" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding LastSleep, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!--The card tap is pointer/touch only; this button keeps the profile reachable by keyboard and screen readers-->
                                            <Button Text="View profile"
                                                    Style="{StaticResource SecondaryAction}"
                                                    HorizontalOptions="End"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='View profile for {0}'}"
                                                    Clicked="OnViewProfileClicked" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToastView />
    </Grid>
</ContentPage>
