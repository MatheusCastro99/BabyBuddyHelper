<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scheduler="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Pages.CalendarPage"
             Title="Calendar"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">
    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="16">
        <!--The baby filter shares the title row, so the time grid keeps its height on a short phone (#176)-->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
            <VerticalStackLayout Spacing="6">
                <Label Text="Your week" Style="{StaticResource PageTitle}" />
                <Label Text="A gentle look at what’s coming up." Style="{StaticResource BodyText}" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    x:Name="CalendarBabyFilterButton"
                    Text="All babies"
                    Style="{StaticResource SecondaryAction}"
                    VerticalOptions="Start"
                    Clicked="OnCalendarBabyFilterClicked" />
        </Grid>

        <Border Grid.Row="1" Padding="12" BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" StrokeShape="RoundRectangle 28">
            <scheduler:SfScheduler
                x:Name="Calendar"
                View="Week"
                IsAppointmentToolTipEnabled="True"
                Tapped="OnCalendarTapped"
                DoubleTapped="OnCalendarDoubleTapped"
                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                BackgroundColor="{DynamicResource BabyBuddySurface}"
                MinimumHeightRequest="420">
            </scheduler:SfScheduler>
        </Border>

        <controls:ToastView Grid.RowSpan="2" />
    </Grid>
</ContentPage>