<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Pages.ChatPage"
             Title="Talk to Cub"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">

    <ContentPage.Resources>
        <!--The parent's messages sit on the right and Cub's on the left; the thinking and failure lines are plain text, not bubbles.
            Bubbles are capped in width, so a long message wraps instead of filling the row.
            PrimaryDarkText keeps the bubble text well above 4.5:1 in both palettes-->
        <controls:ChatItemTemplateSelector x:Key="ChatItemTemplates">
            <controls:ChatItemTemplateSelector.ParentTemplate>
                <DataTemplate x:DataType="controls:ChatItem">
                    <Grid Padding="0,0,0,10">
                        <Border HorizontalOptions="End"
                                MaximumWidthRequest="520"
                                Margin="48,0,0,0"
                                Padding="14,10"
                                BackgroundColor="{DynamicResource BabyBuddySecondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18,18,18,6">
                            <Label Text="{Binding Text}"
                                   TextColor="{DynamicResource PrimaryDarkText}"
                                   LineBreakMode="WordWrap"
                                   SemanticProperties.Description="{Binding Text, StringFormat='You said: {0}'}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </controls:ChatItemTemplateSelector.ParentTemplate>

            <controls:ChatItemTemplateSelector.CubTemplate>
                <DataTemplate x:DataType="controls:ChatItem">
                    <Grid Padding="0,0,0,10">
                        <Border HorizontalOptions="Start"
                                MaximumWidthRequest="520"
                                Margin="0,0,48,0"
                                Padding="14,10"
                                BackgroundColor="{DynamicResource BabyBuddySurface}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18,18,6,18">
                            <Label Text="{Binding Text}"
                                   TextColor="{DynamicResource PrimaryDarkText}"
                                   LineBreakMode="WordWrap"
                                   SemanticProperties.Description="{Binding Text, StringFormat='Cub said: {0}'}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </controls:ChatItemTemplateSelector.CubTemplate>

            <controls:ChatItemTemplateSelector.PendingTemplate>
                <DataTemplate x:DataType="controls:ChatItem">
                    <Grid Padding="4,0,0,10">
                        <Label Text="{Binding Text}" Style="{StaticResource BodyText}" HorizontalOptions="Start" />
                    </Grid>
                </DataTemplate>
            </controls:ChatItemTemplateSelector.PendingTemplate>

            <!--Neutral and in the app's voice, not Cub's (ADR-013). Not an alert: the chat and the rest of the app keep working-->
            <controls:ChatItemTemplateSelector.FailureTemplate>
                <DataTemplate x:DataType="controls:ChatItem">
                    <Grid Padding="4,0,0,10">
                        <Label Text="{Binding Text}" Style="{StaticResource BodyText}" HorizontalOptions="Start" LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </controls:ChatItemTemplateSelector.FailureTemplate>
        </controls:ChatItemTemplateSelector>
    </ContentPage.Resources>

    <Grid>
        <!--SafeAreaEdges="All" keeps the page clear of the system bars and above the on-screen keyboard (pages are edge-to-edge
            by default in .NET 10). The width cap keeps the chat readable on a very wide desktop window-->
        <Grid RowDefinitions="Auto,*" RowSpacing="18" Padding="20" SafeAreaEdges="All" MaximumWidthRequest="760">

            <!--Cub and the settings gear. Cub stays still here: the chat is a calm place, and the wave belongs to MainPage-->
            <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border BackgroundColor="{DynamicResource BabyBuddySecondary}"
                            StrokeThickness="0"
                            Padding="4"
                            WidthRequest="64"
                            HeightRequest="64"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 20">
                        <controls:CubView SemanticProperties.Description="Cub, your companion" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Cub" Style="{StaticResource SectionTitle}" />
                        <Label Text="Here for everyday tips and a kind word." Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>

                    <!--48x48 touch area (the Android minimum) around a ~22px icon, drawn in a mid-tone of the current palette like the edit and trash icons-->
                    <ImageButton Grid.Column="2"
                                 Source="{DynamicResource GearIcon}"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Padding="13"
                                 Aspect="AspectFit"
                                 BackgroundColor="Transparent"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Cub's settings"
                                 SemanticProperties.Hint="Opens the settings for your Claude API key"
                                 Clicked="OnOpenSettingsClicked" />
                </Grid>
            </Border>

            <!--No key saved yet. This is an invitation, not an error: the rest of the app works without a key (ADR-017).
                Both states start hidden and one is shown once the key store has answered, so neither flashes by-->
            <Border x:Name="SetupState"
                    Grid.Row="1"
                    IsVisible="False"
                    VerticalOptions="Start"
                    BackgroundColor="{DynamicResource BabyBuddySurface}"
                    StrokeThickness="0"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Cub needs a key to chat" Style="{StaticResource SectionTitle}" />
                    <Label Text="Cub's answers come from Claude, an AI service. Add your own Claude API key to start talking."
                           Style="{StaticResource BodyText}" />
                    <Button Text="Add my key"
                            Style="{StaticResource PrimaryAction}"
                            HorizontalOptions="Start"
                            Clicked="OnOpenSettingsClicked" />
                </VerticalStackLayout>
            </Border>

            <!--A key is saved: the baby picker, the conversation, the message box, and the fixed "not medical advice" line under it-->
            <Grid x:Name="ChatState" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                <!--What Cub may know about: nothing ("General advice", the default) or one baby. A change applies from the next message.
                    The page reads the choice when a message is sent, so nothing about the baby leaves the device until then (ADR-017)-->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Chatting about" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                    <Picker x:Name="BabyPicker"
                            MinimumWidthRequest="180"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Which baby Cub can know about" />
                </HorizontalStackLayout>

                <!--The conversation, newest at the bottom-->
                <CollectionView x:Name="ConversationView" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource ChatItemTemplates}">
                    <CollectionView.EmptyView>
                        <Grid>
                            <Label Text="Ask Cub about everyday baby care."
                                   Style="{StaticResource BodyText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Grid>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!--The message box grows with the text up to a few lines, then scrolls inside itself-->
                <Border Grid.Row="2" BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeShape="RoundRectangle 22" Padding="12,6,6,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Editor x:Name="MessageEditor"
                                Placeholder="Write to Cub"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MaximumHeightRequest="120"
                                MaxLength="2000"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Message to Cub"
                                TextChanged="OnMessageTextChanged" />
                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Text="Send"
                                Style="{StaticResource PrimaryAction}"
                                VerticalOptions="End"
                                IsEnabled="False"
                                Clicked="OnSendClicked" />
                    </Grid>
                </Border>

                <Label Grid.Row="3"
                       Text="Cub offers general tips, not medical advice. For anything about your baby's health, check with your pediatrician."
                       Style="{StaticResource CaptionText}"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Grid>

        <controls:ToastView />
    </Grid>
</ContentPage>
