<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BabyBuddyHelper.UI.Pages"
             xmlns:converters="clr-namespace:BabyBuddyHelper.UI.Converters"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Pages.ChecklistPage"
             x:Name="ChecklistRoot"
             Title="Checklist"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsAppointmentModelConverter x:Key="IsAppointmentModelConverter"/>
            <converters:AssociatedBabyNameConverter x:Key="AssociatedBabyNameConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,8,0,0">
            <Label Text="Today's rhythm" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
            <Label Text="Small steps, steady care." Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Padding="14,10" StrokeThickness="0" BackgroundColor="{DynamicResource BabyBuddySurface}" MaximumWidthRequest="650">
            <Grid ColumnDefinitions="*,Auto,*">
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" Spacing="8" VerticalOptions="Center">
                    <Label Text="Pending first" VerticalOptions="Center" Style="{StaticResource BodyText}" />
                    <Grid WidthRequest="44" HeightRequest="28">
                        <Switch x:Name="PendingFirstSwitch"
                                IsToggled="{Binding isPendingFirst}"
                                Toggled="IsPendingFirstHandler"
                                Opacity="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

                        <!--The off and on tracks are two borders, not one border with a trigger: a trigger that sets a
                            DynamicResource drops the base one when it turns off, and the track then misses palette swaps (#93)-->
                        <Border InputTransparent="True"
                                WidthRequest="36"
                                HeightRequest="20"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource BabyBuddyBorder}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <Border InputTransparent="True"
                                WidthRequest="36"
                                HeightRequest="20"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource BabyBuddyPrimary}"
                                IsVisible="{Binding Source={x:Reference PendingFirstSwitch}, Path=IsToggled}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <!--Appears on keyboard focus (KeyboardFocusRing)-->
                        <Border x:Name="PendingFirstFocusRing"
                                InputTransparent="True"
                                IsVisible="False"
                                WidthRequest="44"
                                HeightRequest="28"
                                StrokeThickness="2"
                                Stroke="{DynamicResource BabyBuddyText}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <Ellipse InputTransparent="True"
                                 WidthRequest="14"
                                 HeightRequest="14"
                                 Fill="{DynamicResource BabyBuddyText}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 TranslationX="-8">
                            <Ellipse.Triggers>
                                <DataTrigger TargetType="Ellipse" Binding="{Binding Source={x:Reference PendingFirstSwitch}, Path=IsToggled}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource White}" />
                                    <Setter Property="TranslationX" Value="8" />
                                </DataTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Start" Spacing="8" VerticalOptions="Center">
                    <Label Text="Upcoming first" VerticalOptions="Center" Style="{StaticResource BodyText}" />
                    <Grid WidthRequest="44" HeightRequest="28">
                        <Switch x:Name="DateOrderSwitch"
                                Toggled="IsDateOrderHandler"
                                Opacity="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

                        <!--The off and on tracks are two borders, not one border with a trigger: a trigger that sets a
                            DynamicResource drops the base one when it turns off, and the track then misses palette swaps (#93)-->
                        <Border InputTransparent="True"
                                WidthRequest="36"
                                HeightRequest="20"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource BabyBuddyBorder}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <Border InputTransparent="True"
                                WidthRequest="36"
                                HeightRequest="20"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource BabyBuddyPrimary}"
                                IsVisible="{Binding Source={x:Reference DateOrderSwitch}, Path=IsToggled}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <!--Appears on keyboard focus (KeyboardFocusRing)-->
                        <Border x:Name="DateOrderFocusRing"
                                InputTransparent="True"
                                IsVisible="False"
                                WidthRequest="44"
                                HeightRequest="28"
                                StrokeThickness="2"
                                Stroke="{DynamicResource BabyBuddyText}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        <Ellipse InputTransparent="True"
                                 WidthRequest="14"
                                 HeightRequest="14"
                                 Fill="{DynamicResource BabyBuddyText}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 TranslationX="-8">
                            <Ellipse.Triggers>
                                <DataTrigger TargetType="Ellipse" Binding="{Binding Source={x:Reference DateOrderSwitch}, Path=IsToggled}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource White}" />
                                    <Setter Property="TranslationX" Value="8" />
                                </DataTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </HorizontalStackLayout>

                <Button x:Name="ChecklistBabyFilterButton"
                        Grid.Column="2"
                        Text="All babies"
                        Style="{StaticResource SecondaryAction}"
                        HorizontalOptions="End"
                        Clicked="OnChecklistBabyFilterClicked"/>
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding TaskList}" SelectionMode="Single" MaximumWidthRequest="750" Margin="0,0,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Padding="16" Margin="0,5" BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                            <StackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <HorizontalStackLayout Spacing="0">
                                            <Label Text="{Binding TaskName}" FontSize="18" FontAttributes="Bold" />
                                            <Label Style="{StaticResource BodyText}" VerticalTextAlignment="End">
                                                <Label.Text>
                                                    <MultiBinding Converter="{StaticResource AssociatedBabyNameConverter}" StringFormat=" - {0}">
                                                        <Binding Path="AssociatedBabyId" />
                                                        <Binding Source="{x:Reference ChecklistRoot}" Path="BabyNamesById" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TaskDescription}" Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                    </VerticalStackLayout>

                                    <!--No column spacing: each icon button's 13px padding already spaces the icons apart-->
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="0" VerticalOptions="Center">
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" CheckedChanged="OnTaskCompletedChanged" HorizontalOptions="End" VerticalOptions="Center" Grid.Column="0" />

                                        <!--Same icon buttons as the vaccine rows on BabyProfilePage: keyboard and screen-reader reachable, drawn in a mid-tone of the current palette so they keep 3:1 against the card.
                                            44x44 touch area around an ~18px icon-->
                                        <ImageButton Grid.Column="1"
                                                     Source="{DynamicResource EditIcon}"
                                                     WidthRequest="44"
                                                     HeightRequest="44"
                                                     Padding="13"
                                                     Aspect="AspectFit"
                                                     BackgroundColor="Transparent"
                                                     VerticalOptions="Center"
                                                     SemanticProperties.Description="{Binding TaskName, StringFormat='Edit {0}'}"
                                                     Command="{Binding Source={x:Reference ChecklistRoot}, Path=EditTaskCommand}"
                                                     CommandParameter="{Binding .}" />

                                        <ImageButton Grid.Column="2"
                                                     Source="{DynamicResource TrashIcon}"
                                                     WidthRequest="44"
                                                     HeightRequest="44"
                                                     Padding="13"
                                                     Aspect="AspectFit"
                                                     BackgroundColor="Transparent"
                                                     VerticalOptions="Center"
                                                     SemanticProperties.Description="{Binding TaskName, StringFormat='Delete {0}'}"
                                                     Command="{Binding Source={x:Reference ChecklistRoot}, Path=DeleteTaskCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </Grid>
                                </Grid>

                                <Border Padding="8,6" StrokeThickness="0" BackgroundColor="{DynamicResource BabyBuddySecondary}" HorizontalOptions="Start">
                                    <Label Text="{Binding TaskPriority, StringFormat='Priority {0}'}" Style="{StaticResource CaptionText}" />
                                </Border>

                                <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                    <Label Text="{Binding AppointmentDate, StringFormat='{0:d}'}" Style="{StaticResource CaptionText}" />
                                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="{DynamicResource BabyBuddyBorder}" />
                                    <Label Text="{Binding AppointmentStartTime, StringFormat='{0:hh\:mm}'}" Style="{StaticResource CaptionText}" />
                                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="{DynamicResource BabyBuddyBorder}" />
                                    <Label Text="{Binding AppointmentLocation}" Style="{StaticResource CaptionText}" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <FlexLayout Grid.Row="3" JustifyContent="Center" Padding="0,10,0,0" MaximumWidthRequest="450">
            <Button
                x:Name="AddTaskBtn"
                Text="Add task"
                Style="{StaticResource PrimaryAction}"
                SemanticProperties.Hint="Adds a Task to the list"
                Clicked="onAddTaskClicked"
                HorizontalOptions="Center" />
        </FlexLayout>

        <controls:ToastView Grid.RowSpan="4" />
    </Grid>
</ContentPage>