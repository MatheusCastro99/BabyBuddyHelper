<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Pages.BabyProfilePage"
             Title="Baby Profile"
             BackgroundColor="{DynamicResource BabyBuddyBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--One vaccine row, shared by the routine and seasonal lists-->
            <DataTemplate x:Key="VaccineRowTemplate">
                <!--Tapping a vaccine opens its record editor, same as tapping a baby card on MainPage-->
                <Border Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                        SemanticProperties.Hint="Opens this vaccine's record">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVaccineTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" VerticalOptions="Center" Margin="0,0,4,0" />
    
                        <!--The row tap is pointer/touch only; this button keeps the record reachable by keyboard and screen readers.
                            Same pencil as the task cards, drawn in a mid-tone of the current palette so it keeps 3:1 against the row. 44x44 touch area around an ~18px icon-->
                        <ImageButton Grid.Column="1"
                                     Source="{DynamicResource EditIcon}"
                                     WidthRequest="44"
                                     HeightRequest="44"
                                     Padding="13"
                                     Aspect="AspectFit"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="{Binding Name, StringFormat='Edit the {0} record'}"
                                     Clicked="OnOpenRecordClicked" />
    
                        <BoxView Grid.Column="2" WidthRequest="1" HeightRequest="20" Color="{DynamicResource BabyBuddyBorder}" VerticalOptions="Center" />
    
                        <!--The status is spelled out ("Not started", "1 of 3", "Complete", "Last: Oct 3", "Current"), never shown by color alone.
                            Complete and Current turn soft green; the text switches to PrimaryDarkText because the muted caption color is too faint on green-->
                        <Border Grid.Column="3" Padding="10,4" BackgroundColor="{DynamicResource BabyBuddySecondary}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPillHighlighted}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource BabyBuddySuccess}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding PillText}" Style="{StaticResource CaptionText}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPillHighlighted}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource PrimaryDarkText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
    
                        <!--Stacked rather than in separate grid rows: a stack skips the hidden status line, so rows without one keep the same spacing-->
                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="4" Spacing="4">
                            <!--Next dose, due today, or a gentle overdue reminder. The wording carries the meaning, with no alarm styling-->
                            <!--Plain status line: a lone label, so the long overdue line can wrap-->
                            <Label Text="{Binding StatusLine}" IsVisible="{Binding HasPlainStatusLine}" Style="{StaticResource BodyText}" />
    
                            <!--Due soon: the date first, then the pill. The text here is always a short "Next dose: ..." line, so a horizontal stack is safe-->
                            <HorizontalStackLayout IsVisible="{Binding IsDueSoon}" Spacing="8">
                                <Label Text="{Binding StatusLine}" Style="{StaticResource BodyText}" VerticalOptions="Center" />
    
                                <Border Style="{StaticResource DueTag}">
                                    <Label Text="Due soon" Style="{StaticResource DueTagText}" />
                                </Border>
                            </HorizontalStackLayout>
    
                            <Label Text="{Binding Description}" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--AddBabyPage and AddVaccineRecordPage show their toasts after closing, which land here, so this page hosts its own ToastView-->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">
                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="{Binding AgeText}" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Edit profile"
                                Style="{StaticResource PrimaryAction}"
                                Padding="14,10"
                                VerticalOptions="Center"
                                Clicked="OnEditClicked" />
                    </Grid>
                </Border>

                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Growth" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Weight" Style="{StaticResource CaptionText}" />
                                    <Label Text="{Binding WeightInLbs, StringFormat='{}{0:F1} lbs'}" Style="{StaticResource SectionTitle}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Height" Style="{StaticResource CaptionText}" />
                                    <Label Text="{Binding HeightInFt, StringFormat='{}{0:F1} ft'}" Style="{StaticResource SectionTitle}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Feeding &amp; sleep" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Last feed" Style="{StaticResource CaptionText}" />
                                    <Label Text="{Binding LastFeed, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource SectionTitle}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Last sleep" Style="{StaticResource CaptionText}" />
                                    <Label Text="{Binding LastSleep, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource SectionTitle}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Vaccines" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />

                        <!--Placed above the list so it stays visible without scrolling past every vaccine-->
                        <Label x:Name="VaccineDisclaimerLabel" Style="{StaticResource CaptionText}" />

                        <VerticalStackLayout x:Name="VaccineList" Spacing="10" BindableLayout.ItemTemplate="{StaticResource VaccineRowTemplate}" />

                        <!--Flu and COVID-19 come around again each season, so their rows read "Current" rather than "Complete" (#82)-->
                        <Label Text="Seasonal vaccines" Style="{StaticResource ItemTitle}" SemanticProperties.HeadingLevel="Level3" Margin="0,8,0,0" />

                        <VerticalStackLayout x:Name="SeasonalVaccineList" Spacing="10" BindableLayout.ItemTemplate="{StaticResource VaccineRowTemplate}" />

                        <!--Stacked rather than side by side, so the date doesn't squeeze into a few words per line on narrow screens-->
                        <VerticalStackLayout Spacing="8">
                            <!--"Current" is a date rule (#82), not a statement that the baby is up to date, so it says so next to the source-->
                            <Label Text="&quot;Current&quot; means a seasonal shot in the last 12 months, with the next one not due yet. Your pediatrician can tell you if your baby is fully up to date." Style="{StaticResource CaptionText}" />

                            <Label x:Name="VaccineLastReviewedLabel" Style="{StaticResource CaptionText}" />

                            <Button Text="View the CDC schedule"
                                    Style="{StaticResource SecondaryAction}"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Hint="Opens the CDC vaccine schedule in your browser"
                                    Clicked="OnViewScheduleClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Delete profile" Style="{StaticResource SecondaryAction}" Clicked="OnDeleteClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToastView />
    </Grid>
</ContentPage>
