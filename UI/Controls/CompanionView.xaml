<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Controls.CompanionView"
             x:Name="CompanionRoot">

    <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource BabyBuddySecondary}"
                    StrokeThickness="0"
                    Padding="8"
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 28">
                <controls:CubView x:Name="Cub"
                                  WidthRequest="80"
                                  HeightRequest="80"
                                  SemanticProperties.Description="Cub, your companion">
                    <controls:CubView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCubTapped" />
                    </controls:CubView.GestureRecognizers>
                </controls:CubView>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Label Text="Cub says" Style="{StaticResource SectionTitle}" />
                <Label x:Name="MessageLabel"
                       Text="{Binding Message, Source={x:Reference CompanionRoot}}"
                       Style="{StaticResource BodyText}"
                       LineBreakMode="WordWrap" />
                <!--Two separate features side by side: a canned tip that needs nothing, and the chat (#100).
                    The row wraps, so on a narrow phone the second button drops under the first-->
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start">
                    <Button Text="Tell me something"
                            Style="{StaticResource SecondaryAction}"
                            Margin="0,0,10,8"
                            Clicked="OnTellMeSomethingClicked" />
                    <Button Text="Talk to Cub"
                            Style="{StaticResource SecondaryAction}"
                            Margin="0,0,10,8"
                            SemanticProperties.Hint="Opens a chat with Cub"
                            Clicked="OnTalkToCubClicked" />
                </FlexLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
