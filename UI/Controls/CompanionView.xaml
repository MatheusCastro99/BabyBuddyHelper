<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.UI.Controls"
             x:Class="BabyBuddyHelper.UI.Controls.CompanionView"
             x:Name="CompanionRoot">

    <Border BackgroundColor="{DynamicResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
        <!--Cub on the left, the tip and the two buttons on the right. The buttons sit in their own row under the tip, beside Cub, and
            OnCardSizeChanged moves them to the full card width when a word of a button wouldn't fit beside Cub (large text), so a label never breaks mid-word-->
        <Grid x:Name="CardGrid"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="10"
              VerticalOptions="Center"
              SizeChanged="OnCardSizeChanged">
            <Border x:Name="CubFrame"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    BackgroundColor="{DynamicResource BabyBuddySecondary}"
                    StrokeThickness="0"
                    Padding="8"
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 28">
                <controls:CubView x:Name="Cub"
                                  WidthRequest="80"
                                  HeightRequest="80"
                                  AutomationProperties.IsInAccessibleTree="False">
                    <controls:CubView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCubTapped" />
                    </controls:CubView.GestureRecognizers>
                </controls:CubView>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="End">
                <Label Text="Cub says" Style="{StaticResource SectionTitle}" />
                <Label x:Name="MessageLabel"
                       Text="{Binding Message, Source={x:Reference CompanionRoot}}"
                       Style="{StaticResource BodyText}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!--Two separate features side by side: a canned tip that needs nothing, and the chat (#100).
                The row wraps, so on a narrow phone the second button drops under the first, and the button style wraps a label that
                is wider than the column, instead of clipping it-->
            <FlexLayout x:Name="ActionsRow" Grid.Row="1" Grid.Column="1" Wrap="Wrap" Direction="Row" AlignItems="Start">
                <Button x:Name="TellMeSomethingButton"
                        Text="Tell me something"
                        Style="{StaticResource SecondaryAction}"
                        Margin="0,0,10,8"
                        Clicked="OnTellMeSomethingClicked" />
                <Button x:Name="TalkToCubButton"
                        Text="Talk to Cub"
                        Style="{StaticResource SecondaryAction}"
                        Margin="0,0,10,8"
                        SemanticProperties.Hint="Opens a chat with Cub"
                        Clicked="OnTalkToCubClicked" />
            </FlexLayout>
        </Grid>
    </Border>

</ContentView>
