<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyBuddyHelper.UI.Controls.ToastView"
             x:Name="ToastRoot"
             InputTransparent="True"
             IsVisible="False"
             Opacity="0"
             HorizontalOptions="Fill"
             VerticalOptions="End"
             Margin="12,0,12,18">

    <Border BackgroundColor="{StaticResource BabyBuddySurface}"
            StrokeThickness="0"
            Padding="12,10"
            StrokeShape="RoundRectangle 20"
            HorizontalOptions="Fill">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Border Grid.Column="0"
                    x:Name="ToastBadge"
                    BackgroundColor="{StaticResource BabyBuddySecondary}"
                    StrokeThickness="0"
                    Padding="4"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 14">
                <Image Source="companion_cub.png"
                       Aspect="AspectFit"
                       SemanticProperties.Description="Cub, your companion" />
            </Border>

            <Label Grid.Column="1"
                   Text="{Binding Message, Source={x:Reference ToastRoot}}"
                   Style="{StaticResource BodyText}"
                   LineBreakMode="WordWrap"
                   VerticalOptions="Center" />
        </Grid>
    </Border>

</ContentView>
