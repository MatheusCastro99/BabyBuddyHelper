<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyBuddyHelper.Controls.CompanionView"
             x:Name="CompanionRoot">

    <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
            <Border Grid.Column="0"
                    x:Name="CubBadge"
                    BackgroundColor="{StaticResource BabyBuddySecondary}"
                    StrokeThickness="0"
                    Padding="8"
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 28">
                <Image Source="companion_cub.png"
                       Aspect="AspectFit"
                       WidthRequest="80"
                       HeightRequest="80"
                       SemanticProperties.Description="Cub, your companion" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Label Text="Cub says" Style="{StaticResource SectionTitle}" />
                <Label x:Name="MessageLabel"
                       Text="{Binding Message, Source={x:Reference CompanionRoot}}"
                       Style="{StaticResource BodyText}"
                       LineBreakMode="WordWrap" />
                <Button Text="Tell me something"
                        Style="{StaticResource SecondaryAction}"
                        HorizontalOptions="Start"
                        Clicked="OnTellMeSomethingClicked" />
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
