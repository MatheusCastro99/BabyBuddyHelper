<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#5C8D8D</Color>
    <Color x:Key="PrimaryDark">#A9D1CF</Color>
    <Color x:Key="PrimaryDarkText">#213B3B</Color>
    <Color x:Key="Secondary">#F7E6D5</Color>
    <Color x:Key="SecondaryDarkText">#6E5641</Color>
    <Color x:Key="Tertiary">#F4C7B6</Color>

    <Color x:Key="BabyBuddyBackground">#FFF8F3</Color>
    <Color x:Key="BabyBuddySurface">#FFFDFB</Color>
    <Color x:Key="BabyBuddySurfaceAlt">#F2F9F7</Color>
    <Color x:Key="BabyBuddyPrimary">#5C8D8D</Color>
    <Color x:Key="BabyBuddySecondary">#F7E6D5</Color>
    <Color x:Key="BabyBuddyAccent">#E8B8B8</Color>
    <Color x:Key="BabyBuddySuccess">#B9D7C1</Color>
    <Color x:Key="BabyBuddyWarm">#F9D6B5</Color>
    <Color x:Key="BabyBuddyText">#2E2A2A</Color>
    <Color x:Key="BabyBuddyMuted">#6F6A69</Color>
    <Color x:Key="BabyBuddyBorder">#E7DED6</Color>
    <Color x:Key="BabyBuddyShadow">#EDE2D9</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#23414B</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E8E2DE</Color>
    <Color x:Key="Gray200">#D8D0CC</Color>
    <Color x:Key="Gray300">#B9B0AD</Color>
    <Color x:Key="Gray400">#8E8582</Color>
    <Color x:Key="Gray500">#6E6A67</Color>
    <Color x:Key="Gray600">#4B4745</Color>
    <Color x:Key="Gray900">#2B2827</Color>
    <Color x:Key="Gray950">#1A1818</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="BabyBuddyBackgroundBrush" Color="{StaticResource BabyBuddyBackground}"/>
    <SolidColorBrush x:Key="BabyBuddySurfaceBrush" Color="{StaticResource BabyBuddySurface}"/>
    <SolidColorBrush x:Key="BabyBuddySurfaceAltBrush" Color="{StaticResource BabyBuddySurfaceAlt}"/>
    <SolidColorBrush x:Key="BabyBuddyPrimaryBrush" Color="{StaticResource BabyBuddyPrimary}"/>
    <SolidColorBrush x:Key="BabyBuddyAccentBrush" Color="{StaticResource BabyBuddyAccent}"/>
    <SolidColorBrush x:Key="BabyBuddySuccessBrush" Color="{StaticResource BabyBuddySuccess}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>