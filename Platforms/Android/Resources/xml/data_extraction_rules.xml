<?xml version="1.0" encoding="utf-8"?>
<!--Backup rules for Android 12+ (android:dataExtractionRules). Same rule as auto_backup_rules.xml: only the secure
    storage file is left out, for cloud backups and for device-to-device transfers. Update the file name if ApplicationId changes-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="sharedpref" path="com.companyname.BabyBuddyHelper.microsoft.maui.essentials.preferences.xml" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="sharedpref" path="com.companyname.BabyBuddyHelper.microsoft.maui.essentials.preferences.xml" />
	</device-transfer>
</data-extraction-rules>
