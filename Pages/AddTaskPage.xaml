<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyBuddyHelper.Pages.AddTaskPage"
             Title="Add Task"
             BackgroundColor="{StaticResource BabyBuddyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Add care moment" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="Keep the next step simple and clear." Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="18">
                    <Entry x:Name="TaskNameEntry" Placeholder="Task name" />
                    <Entry x:Name="DescriptionEntry" Placeholder="Description" />

                    <Border BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 16" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Priority" VerticalOptions="Center" Style="{StaticResource SectionTitle}" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource BabyBuddySurface}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 10" Padding="10,6" WidthRequest="48" HeightRequest="40">
                                <Label Text="{Binding Source={x:Reference PriorityStepper}, Path=Value, StringFormat='{0:F0}'}" VerticalOptions="Center" HorizontalOptions="Center" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource BabyBuddySurface}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 10" Padding="0" MinimumWidthRequest="120">
                                <Stepper x:Name="PriorityStepper" Minimum="1" Maximum="10" Value="5" HorizontalOptions="Fill" VerticalOptions="Center" BackgroundColor="Transparent" HeightRequest="44" />
                            </Border>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Appointment" VerticalOptions="Center" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="IsAppointmentCheckBox" />
                    </HorizontalStackLayout>

                    <StackLayout IsVisible="{Binding Source={x:Reference IsAppointmentCheckBox}, Path=IsChecked}" Spacing="12" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Date" Style="{StaticResource SectionTitle}" />
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <DatePicker x:Name="DateEntry" MinimumDate="01/01/2025" HeightRequest="44" />
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="Start" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            <Label Grid.Row="2" Grid.Column="1" Text="End" Style="{StaticResource BodyText}" VerticalOptions="Center" HorizontalTextAlignment="End" />

                            <Border Grid.Row="3" Grid.Column="0" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <TimePicker x:Name="StartingTimeEntry" HeightRequest="44" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <TimePicker x:Name="EndingTimeEntry" HeightRequest="44" />
                            </Border>

                            <Label Grid.Row="4" Grid.Column="0" Text="Location" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" Stroke="{StaticResource BabyBuddyBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                                <Entry x:Name="LocationEntry" Placeholder="Location" />
                            </Border>
                        </Grid>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryAction}" Clicked="OnCancelClicked" />
                <Button Grid.Column="1" Text="Save" Style="{StaticResource PrimaryAction}" Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>