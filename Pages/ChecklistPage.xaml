<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BabyBuddyHelper.Pages"
             xmlns:styles="clr-namespace:BabyBuddyHelper.Resources.Styles"
             xmlns:controls="clr-namespace:BabyBuddyHelper.Controls"
             x:Class="BabyBuddyHelper.Pages.ChecklistPage"
             x:Name="ChecklistRoot"
             Title="Checklist"
             BackgroundColor="{StaticResource BabyBuddyBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <styles:IsAppointmentModelConverter x:Key="IsAppointmentModelConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,8,0,0">
            <Label Text="Today's rhythm" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
            <Label Text="Small steps, steady care." Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Padding="14,5" StrokeThickness="0" BackgroundColor="{StaticResource BabyBuddySurface}" MaximumWidthRequest="650">
            <HorizontalStackLayout HorizontalOptions="Start" Spacing="8" VerticalOptions="Center">
                <Label Text="Pending first" VerticalOptions="Center" Style="{StaticResource BodyText}" />
                <Grid WidthRequest="44" HeightRequest="24">
                    <Switch x:Name="PendingFirstSwitch"
                            IsToggled="{Binding isPendingFirst}"
                            Toggled="IsPendingFirstHandler"
                            Opacity="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                    <Border InputTransparent="True"
                            WidthRequest="36"
                            HeightRequest="20"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource BabyBuddyBorder}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PendingFirstSwitch}, Path=IsToggled}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BabyBuddyPrimary}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <Ellipse InputTransparent="True"
                             WidthRequest="14"
                             HeightRequest="14"
                             Fill="{StaticResource BabyBuddyText}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             TranslationX="-8">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding Source={x:Reference PendingFirstSwitch}, Path=IsToggled}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource White}" />
                                <Setter Property="TranslationX" Value="8" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
            </HorizontalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding TaskList}" SelectionMode="Single" MaximumWidthRequest="750" Margin="0,0,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Padding="16" Margin="0,5" BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                            <StackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <HorizontalStackLayout Spacing="0">
                                            <Label Text="{Binding TaskName}" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="{Binding AssociatedBabyDisplayName, StringFormat=' - {0}'}" Style="{StaticResource BodyText}" VerticalTextAlignment="End" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TaskDescription}" Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                    </VerticalStackLayout>

                                    <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <CheckBox IsChecked="{Binding IsCompleted}" CheckedChanged="OnTaskCompletedChanged" HorizontalOptions="End" VerticalOptions="Center" Grid.Column="0" />

                                        <Path Data="M535.6 85.7C513.7 63.8 478.3 63.8 456.4 85.7L432 110.1L529.9 208L554.3 183.6C576.2 161.7 576.2 126.3 554.3 104.4L535.6 85.7zM236.4 305.7C230.3 311.8 225.6 319.3 222.9 327.6L193.3 416.4C190.4 425 192.7 434.5 199.1 441C205.5 447.5 215 449.7 223.7 446.8L312.5 417.2C320.7 414.5 328.2 409.8 334.4 403.7L496 241.9L398.1 144L236.4 305.7zM160 128C107 128 64 171 64 224L64 480C64 533 107 576 160 576L416 576C469 576 512 533 512 480L512 384C512 366.3 497.7 352 480 352C462.3 352 448 366.3 448 384L448 480C448 497.7 433.7 512 416 512L160 512C142.3 512 128 497.7 128 480L128 224C128 206.3 142.3 192 160 192L256 192C273.7 192 288 177.7 288 160C288 142.3 273.7 128 256 128L160 128z"
                                              HeightRequest="18"
                                              WidthRequest="18"
                                              Fill="{StaticResource BabyBuddyPrimary}"
                                              VerticalOptions="Center"
                                              Grid.Column="1">
                                            <Path.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChecklistRoot}, Path=EditTaskCommand}" CommandParameter="{Binding .}"/>
                                            </Path.GestureRecognizers>
                                        </Path>

                                        <Path Data="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z"
                                              HeightRequest="18"
                                              WidthRequest="18"
                                              Fill="{StaticResource BabyBuddyAccent}"
                                              VerticalOptions="Center"
                                              Grid.Column="2">
                                            <Path.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChecklistRoot}, Path=DeleteTaskCommand}" CommandParameter="{Binding .}"/>
                                            </Path.GestureRecognizers>
                                        </Path>
                                    </Grid>
                                </Grid>

                                <Border Padding="8,6" StrokeThickness="0" BackgroundColor="{StaticResource BabyBuddySecondary}" HorizontalOptions="Start">
                                    <Label Text="{Binding TaskPriority, StringFormat='Priority {0}'}" Style="{StaticResource CaptionText}" />
                                </Border>

                                <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                    <Label Text="{Binding AppointmentDate, StringFormat='{0:d}'}" Style="{StaticResource CaptionText}" />
                                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="{StaticResource BabyBuddyBorder}" />
                                    <Label Text="{Binding AppointmentStartTime, StringFormat='{0:hh\:mm}'}" Style="{StaticResource CaptionText}" />
                                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="{StaticResource BabyBuddyBorder}" />
                                    <Label Text="{Binding AppointmentLocation}" Style="{StaticResource CaptionText}" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <FlexLayout Grid.Row="3" JustifyContent="Center" Padding="0,10,0,0" MaximumWidthRequest="450">
            <Button
                x:Name="AddTaskBtn"
                Text="Add task"
                Style="{StaticResource PrimaryAction}"
                SemanticProperties.Hint="Adds a Task to the list"
                Clicked="onAddTaskClicked"
                HorizontalOptions="Center" />
        </FlexLayout>

        <controls:ToastView Grid.RowSpan="4" />
    </Grid>
</ContentPage>