<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BabyBuddyHelper.Pages"
             x:Class="BabyBuddyHelper.Pages.ChecklistPage"
             Title="ChecklistPage">
    <ScrollView>
        <VerticalStackLayout>
            <Label
                Style="{StaticResource SubHeadline}"
                Text="Classes | Appointments | Task"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Margin="0,20"/>
            <HorizontalStackLayout
                x:Name="FiltersLayout"
                Padding="10"
                 MaximumWidthRequest="750">
                
                <Label
                    Text="Pending First"
                    VerticalOptions="Center"
                    Margin="0, 0, 10, 0"/>
                <Switch 
                    IsToggled="{Binding isPendingFirst}"
                    Toggled="IsPendingFirstHandler"
                    OnColor="Green"
                    ThumbColor="White" />

            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding TaskList}" SelectionMode="Single" MaximumWidthRequest="750">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="15" Margin="10" BackgroundColor="Gray" StrokeShape="RoundRectangle 15,15,15,15" >
                            <StackLayout Spacing="3">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Text="{Binding TaskName}" FontSize="16" FontAttributes="Bold" Grid.Column="0"/>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Grid.Column="1" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsCompleted}" HorizontalOptions="End" Grid.Column="0"/>
                                        <BoxView WidthRequest="1" BackgroundColor="LightGray" VerticalOptions="Fill" Margin="40, 0 ,0 , 0"/>
                                        
                                        <!-- Custom Vector Path Fill / Trash can delete Icon -->
                                        <Path Data="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z"
                                              HeightRequest="24"
                                              WidthRequest="24"
                                              Grid.Column="1">
                                            <Path.GestureRecognizers>
                                                <!--Looks for ChecklistPage file, then looks for DeleteTaskCommand, a command that is bound to the DeleteTask method-->
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:ChecklistPage}}, Path=DeleteTaskCommand}"
                                                    CommandParameter="{Binding .}"/>
                                                <!--"Binding ." acts similar as the "this" keyword, passing the TaskModel context that the path is inserted in-->
                                            </Path.GestureRecognizers>
                                        </Path>

                                        <!-- Custom Vector Path Fill / Edit note Icon -->
                                        <Path Data="M535.6 85.7C513.7 63.8 478.3 63.8 456.4 85.7L432 110.1L529.9 208L554.3 183.6C576.2 161.7 576.2 126.3 554.3 104.4L535.6 85.7zM236.4 305.7C230.3 311.8 225.6 319.3 222.9 327.6L193.3 416.4C190.4 425 192.7 434.5 199.1 441C205.5 447.5 215 449.7 223.7 446.8L312.5 417.2C320.7 414.5 328.2 409.8 334.4 403.7L496 241.9L398.1 144L236.4 305.7zM160 128C107 128 64 171 64 224L64 480C64 533 107 576 160 576L416 576C469 576 512 533 512 480L512 384C512 366.3 497.7 352 480 352C462.3 352 448 366.3 448 384L448 480C448 497.7 433.7 512 416 512L160 512C142.3 512 128 497.7 128 480L128 224C128 206.3 142.3 192 160 192L256 192C273.7 192 288 177.7 288 160C288 142.3 273.7 128 256 128L160 128z"
                                              HeightRequest="24"
                                              WidthRequest="24"
                                              Grid.Column="2"> 
                                            
                                        </Path>
                                    </Grid>
                                </Grid>
                                <Label Text="{Binding TaskDescription}" FontSize="12" TextColor="LightGray" />
                                <Label Text="{Binding TaskPriority, StringFormat='Priority: {0}'}"  FontSize="12" TextColor="LightGray"/>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <FlexLayout
                x:Name="BtnsLayout"
                JustifyContent="Center"
                Padding="0, 40"
                MaximumWidthRequest="450">
                <Button
                 x:Name="AddTaskBtn"
                 Text="New Task" 
                 SemanticProperties.Hint="Adds a Task to the list"
                 Clicked="onAddTaskClicked"
                 HorizontalOptions="Center" />
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>