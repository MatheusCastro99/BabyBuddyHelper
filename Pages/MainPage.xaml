<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyPrepRegistry.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="6 Months for baby Hello, World!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Baby registry and prep checklist"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />
            <FlexLayout
                x:Name="BtnsLayout"
                JustifyContent="SpaceBetween"
                Padding="40"
                MaximumWidthRequest="450">
                
                <Button
                    x:Name="CheckListBtn"
                    Text="View CheckList" 
                    SemanticProperties.Hint="Displays baby prepr checklist"
                    Clicked="onCheckListClicked"
                    HorizontalOptions="Center" />
                <Button
                    x:Name="RegistryBtn"
                    Text="View Registry" 
                    SemanticProperties.Hint="Displays baby registry checklist"
                    Clicked="onRegistryClicked"
                    HorizontalOptions="Center" />
            </FlexLayout>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
