<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BabyBuddyHelper.Controls"
             x:Class="BabyBuddyHelper.MainPage"
             Title="Home"
             BackgroundColor="{StaticResource BabyBuddyBackground}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">
                <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="20" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Good morning" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                        <Label Text="{Binding CountdownText}" Style="{StaticResource PageTitle}" />
                        <Label Text="Your little routine is looking calm and steady today." Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                    <Border Grid.Column="0" Grid.Row="0" Padding="16" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource BabyBuddySecondary}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="🗓️" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Today" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="1 appointment" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0" Padding="16" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource BabyBuddySuccess}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="✅" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Checklist" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="2 tasks done" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="0" Grid.Row="1" Padding="16" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource BabyBuddyWarm}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="🧸" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Profiles" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ProfileCountText}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1" Padding="16" BackgroundColor="{StaticResource BabyBuddySurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource BabyBuddyAccent}" StrokeThickness="0" Padding="8,6" HorizontalOptions="Center" StrokeShape="RoundRectangle 12">
                                <Label Text="💛" FontSize="22" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Next up" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                            <Label Text="Pediatrician" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <controls:CompanionView />

                <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Today's progress" Style="{StaticResource SectionTitle}" />
                        <ProgressBar Progress="0.65" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource BabyBuddySurface}" StrokeThickness="0" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Baby profiles" Style="{StaticResource SectionTitle}" />
                                <Label Text="Keep each little routine close and easy to update." Style="{StaticResource BodyText}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Add profile"
                                    Style="{StaticResource PrimaryAction}"
                                    Padding="14,10"
                                    VerticalOptions="Center"
                                    Clicked="OnAddBabyProfileClicked" />
                        </Grid>

                        <Border IsVisible="{Binding HasNoBabyProfiles}"
                                BackgroundColor="{StaticResource BabyBuddySurfaceAlt}"
                                Stroke="{StaticResource BabyBuddyBorder}"
                                Padding="16">
                            <Label Text="No baby profiles yet. Add one whenever you're ready, and we'll keep feeding and sleep details handy for you."
                                   Style="{StaticResource BodyText}" />
                        </Border>

                        <CollectionView ItemsSource="{Binding BabyProfiles}"
                                        IsVisible="{Binding HasBabyProfiles}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16"
                                            Margin="0,0,0,10"
                                            BackgroundColor="{StaticResource BabyBuddySurfaceAlt}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                                    <Label Text="{Binding Age, StringFormat='Age {0}'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        Padding="10,6"
                                                        BackgroundColor="{StaticResource BabyBuddySecondary}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding WeightInLbs, StringFormat='{}{0:F1} lbs'}" Style="{StaticResource CaptionText}" />
                                                </Border>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                                    <Label Text="Height" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding HeightInFt, StringFormat='{}{0:F1} ft'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                                    <Label Text="Last feed" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding LastFeed, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                                    <Label Text="Last sleep" Style="{StaticResource CaptionText}" />
                                                    <Label Text="{Binding LastSleep, StringFormat='{}{0:MMM d, h:mm tt}'}" Style="{StaticResource BodyText}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <Button Grid.Column="0"
                                                        Text="Edit"
                                                        Style="{StaticResource SecondaryAction}"
                                                        Clicked="OnEditBabyProfileClicked" />
                                                <Button Grid.Column="1"
                                                        Text="Delete"
                                                        Style="{StaticResource SecondaryAction}"
                                                        Clicked="OnDeleteBabyProfileClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:ToastView />
    </Grid>
</ContentPage>
