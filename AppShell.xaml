<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BabyBuddyHelper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BabyBuddyHelper"
    xmlns:pages="clr-namespace:BabyBuddyHelper.Pages"
    Title="BabyBuddyHelper">
    
    <TabBar >
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Checklist"
            ContentTemplate="{DataTemplate pages:ChecklistPage}"
            Route="ChecklistPage" />
        <ShellContent
            Title="Registry"
            ContentTemplate="{DataTemplate pages:RegistryPage}"
            Route="RegistryPage" />
    </TabBar>

</Shell>
