<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BabyBuddyHelper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BabyBuddyHelper.UI.Pages"
    Title="BabyBuddyHelper"
    Shell.BackgroundColor="{StaticResource BabyBuddyBackground}"
    Shell.ForegroundColor="{StaticResource BabyBuddyText}"
    Shell.TitleColor="{StaticResource BabyBuddyText}"
    Shell.TabBarBackgroundColor="{StaticResource BabyBuddySurface}"
    Shell.TabBarForegroundColor="{StaticResource BabyBuddyText}"
    Shell.TabBarTitleColor="{StaticResource BabyBuddyText}"
    Shell.TabBarUnselectedColor="{StaticResource Gray400}">
    
    <TabBar >
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Checklist"
            ContentTemplate="{DataTemplate pages:ChecklistPage}"
            Route="ChecklistPage" />
        <ShellContent
            Title="Calendar"
            ContentTemplate="{DataTemplate pages:CalendarPage}"
            Route="CalendarPage" />
    </TabBar>

</Shell>
